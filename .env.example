# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Pulse Application & Scheduler
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-random-cron-secret"

# GitHub App Integration (Read-Only)
# Required permissions: Metadata (read), Contents (read)
# Extra permissions for Feature 3 (Code Health):
#   Actions: read, Checks: read, Commit statuses: read, Deployments: read
GITHUB_APP_ID="your-github-app-id"
GITHUB_APP_SLUG="pulse-monitor"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET="your-github-webhook-secret"

# Email Notifications (Optional / Deferred)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Pulse <alerts@yourdomain.com>"
